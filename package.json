{
  "name": "hammer-mcp",
  "version": "0.0.207-alpha",
  "description": "Local-first MCP server for Source-engine map work: VMF, BSP, entity-lump patches, compile and audit",
  "license": "GPL-3.0-only",
  "author": "NexPG",
  "homepage": "https://github.com/NexPG/L4D2-HSMCP#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NexPG/L4D2-HSMCP.git"
  },
  "bugs": "https://github.com/NexPG/L4D2-HSMCP/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "source-engine",
    "hammer",
    "hammer++",
    "vmf",
    "bsp",
    "left-4-dead-2",
    "level-design"
  ],
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "bin": {
    "hammer-mcp": "./dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "skill"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "pnpm build",
    "docs:tools": "tsx src/core/typescript/docs/generate.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@projectsociety/mcp-core": "^0.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22"
  },
  "os": [
    "win32"
  ]
}

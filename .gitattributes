# Default: let git normalise text to LF in the repository.
* text=auto

# Fixtures are compared byte for byte — line endings are part of what the tests assert,
# and a Windows checkout must not rewrite them.
test/fixtures/** -text

# Third-party source trees live in modules/<area>/native/ and are part of the build's reference
# set, not a hidden vendor bucket. They are counted in the language breakdown on purpose: this
# is a multi-language toolkit, and the C++ is part of what it is.
modules/** linguist-vendored=false

# The artwork inside those trees is binary; keep git from trying to diff it.
modules/**/*.png -diff
modules/**/*.ico -diff
modules/**/*.xcf -diff
modules/**/*.blend -diff
modules/**/*.pdn -diff

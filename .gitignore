node_modules/
dist/
*.log

# Server runtime state: audit trail, FGD cache, compile job logs and file backups.
.hammer-mcp/

# Local configuration, derived from config.example.json.
config.json

# The MCP entry `install` writes: machine-specific absolute paths, not shared source.
.mcp.json

# Python bytecode from the sidecar.
__pycache__/
*.pyc

# Python venv, when sidecar/setup.ps1 builds it in place.
.venv/

# Dogfood runs: a round leaves its brief, its rules and its renders here.
scratchpad/

# Development diary: working notes for this fork, kept locally and never published.
.develop-diary/

# Test campaigns: the directory itself is local, never pushed.
# History lives here; the game only ever holds the latest deploy.
/campaigns/
